# UV ignore file - files and directories to ignore when building/packaging
# See https://docs.astral.sh/uv/

# Build and distribution
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Documentation build
site/
.cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing
.coverage
.pytest_cache/
.tox/
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Log files
*.log
logs/

# Environment variables
.env
.env.local
.env.*.local

# Package manager files
poetry.lock
Pipfile.lock
requirements*.txt  # We use pyproject.toml instead

# Documentation source that shouldn't be in package
docs/
README.md
LICENSE
CHANGELOG.md
